{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rankingselect.local/schemas/sources.schema.json",
  "title": "RankingSelect university package sources",
  "type": "array",
  "items": { "$ref": "#/$defs/source" },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
    },
    "verification_status": {
      "enum": ["discovered", "extracted", "needs_review", "verified", "stale", "rejected"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url", "source_type", "retrieved_at", "verification_status"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "source_type": {
          "enum": ["official_web", "official_api", "official_pdf", "manual_entry", "archive"]
        },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "verification_status": { "$ref": "#/$defs/verification_status" },
        "title": { "type": "string" },
        "content_hash": { "type": "string" },
        "evidence_text": { "type": "string" }
      }
    }
  }
}
